{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "doctype-style": [
      "error",
      {
        "style": "uppercase"
      }
    ],
    "no-inline-style": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "long-title": "off",
    "wcag/h30": "warn",
    "wcag/h63": "warn"
  }
}
